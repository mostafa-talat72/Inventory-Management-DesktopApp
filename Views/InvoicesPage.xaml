<Page x:Class="ProductApp.Views.InvoicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="كل الفواتير"
      FlowDirection="RightToLeft"
      Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" Padding="28,24,28,16" CornerRadius="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource BadgeInfoBg}">
                    <Path FlowDirection="LeftToRight" Width="22" Height="22" Fill="{DynamicResource BadgeInfoFg}" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="كل الفواتير" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="جميع فواتير العملاء والموردين" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="OpenNewInvoice"
                            Height="40" Cursor="Hand" Padding="16,0"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#1A237E" CornerRadius="10" Padding="16,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#283593" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#0D155B" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path FlowDirection="LeftToRight" Grid.Column="0" Width="16" Height="16" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                            <TextBlock Grid.Column="1" Text="  إنشاء فاتورة جديدة" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Click="OpenSupplierOrder"
                            Height="40" Cursor="Hand" Padding="16,0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b2" Background="#00695C" CornerRadius="10" Padding="16,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b2" Property="Background" Value="#00796B" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="b2" Property="Background" Value="#004D40" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path FlowDirection="LeftToRight" Grid.Column="0" Width="16" Height="16" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                            <TextBlock Grid.Column="1" Text="  إضافة طلبية من مورد" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged"
               Background="Transparent" BorderThickness="0">
            <TabItem Header="فواتير المبيعات">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

        <!-- Summary cards -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="عدد الفواتير" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtInvoiceCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="إجمالي المشتريات" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtTotalAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="المدفوع" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtPaidAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="الخصومات" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtDiscountAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="المتبقي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtRemainingAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filter bar + search + sort -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="قائمة الفواتير" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}" Padding="4,0" Height="36" HorizontalAlignment="Left">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BtnUnpaid" CornerRadius="6" Background="#1565C0" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnUnpaid_Click">
                                    <TextBlock x:Name="TxtUnpaid" Text="غير مدفوعة" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnPartiallyPaid" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnPartiallyPaid_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtPartiallyPaid" Text="مدفوعة جزئياً" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnCancelled" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnCancelled_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtCancelled" Text="ملغاة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnPaid" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnPaid_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtPaid" Text="مدفوعة بالكامل" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnAll" CornerRadius="6" Background="Transparent" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnAll_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtAll" Text="كل الفواتير" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnTrash" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnTrash_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtTrash" Text="سلة المحذوفات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Click="ExportExcel_Click" Cursor="Hand" Height="36" Padding="14,0"
                                Margin="0,0,6,0" Background="{DynamicResource CardBackgroundAlt}" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path FlowDirection="LeftToRight" Width="15" Height="15" Fill="#2E7D32" Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Data="M14,2H6C4.9,2 4,2.9 4,4V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2M18,20H6V4H13V9H18V20M8,13H11V11H13V13H16V15H13V17H11V15H8V13Z" />
                                            <TextBlock Text="Excel" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeadingTextBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border x:Name="BtnSort" CornerRadius="6" Background="{DynamicResource CardBackgroundAlt}" Padding="10,0" Height="36" Cursor="Hand" MouseLeftButtonDown="BtnSort_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path FlowDirection="LeftToRight" x:Name="SortIcon" Width="16" Height="16" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
                                <TextBlock x:Name="TxtSort" Text="الأحدث" FontSize="11" Foreground="{DynamicResource BodyTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" Height="32">
                        <Grid>
                            <TextBox x:Name="TxtSearch" FontSize="12" Padding="10,0" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource HeadingTextBrush}"
                                     TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center" />
                            <TextBlock IsHitTestVisible="False" Text="بحث برقم الفاتورة أو اسم العميل..." FontSize="12"
                                       Foreground="#B0BEC5" VerticalAlignment="Center" Margin="12,0,0,0"
                                       x:Name="SearchWatermark" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="من" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <DatePicker x:Name="DpFromDate" Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                SelectedDateChanged="DateFilterChanged" />
                    <TextBlock Grid.Column="3" Text="إلى" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <DatePicker x:Name="DpToDate" Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                SelectedDateChanged="DateFilterChanged" />
                </Grid>
            </Grid>
        </Border>

        <!-- Batch action bar -->
        <Border x:Name="BatchBar" Grid.Row="3" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource BadgePurpleBg}"
                Padding="12,8" Visibility="Collapsed" BorderBrush="{DynamicResource BadgePurpleBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource BadgePurpleBg2}" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBatchCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BadgePurpleFg}" />
                </Border>
                <TextBlock Grid.Column="1" Text="محددة" FontSize="11" Foreground="{DynamicResource BadgePurpleFg}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Border Grid.Column="2" CornerRadius="6" Background="#546E7A" Padding="10,6" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="BatchPrint_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" />
                        <TextBlock Text="طباعة المحدد" FontSize="11" FontWeight="Bold" Foreground="White" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" CornerRadius="6" Background="#C62828" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="BatchClear_Click">
                    <TextBlock Text="إلغاء التحديد" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <!-- Invoice cards list -->
        <StackPanel x:Name="InvoicesPanel" Grid.Row="4" />

        <!-- Show more -->
        <Border x:Name="ShowMoreBar" Grid.Row="5" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}"
                Padding="12,10" Cursor="Hand" MouseLeftButtonDown="ShowMore_Click"
                Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M7 10l5 5 5-5z" />
                <TextBlock x:Name="TxtShowMore" Text="عرض المزيد" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" Margin="6,0,0,0" />
            </StackPanel>
        </Border>
                    </Grid>
            </TabItem>

            <TabItem Header="فواتير الموردين">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

            <!-- Summary cards -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="عدد فواتير التوريد" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TxtSupplierCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="إجمالي التوريدات" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TxtSupplierTotal" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="المدفوع للموردين" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TxtSupplierPaid" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="المتبقي على التوريدات" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="TxtSupplierRemaining" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Filter bar + search + sort -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="فواتير التوريد" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}" Padding="4,0" Height="36" HorizontalAlignment="Left">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="SBtnUnpaid" CornerRadius="6" Background="#1565C0" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="SBtnUnpaid_Click">
                                        <TextBlock x:Name="STxtUnpaid" Text="غير مدفوعة" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SBtnPartiallyPaid" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="SBtnPartiallyPaid_Click" Margin="4,0,0,0">
                                        <TextBlock x:Name="STxtPartiallyPaid" Text="مدفوعة جزئياً" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SBtnCancelled" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="SBtnCancelled_Click" Margin="4,0,0,0">
                                        <TextBlock x:Name="STxtCancelled" Text="ملغاة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SBtnPaid" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="SBtnPaid_Click" Margin="4,0,0,0">
                                        <TextBlock x:Name="STxtPaid" Text="مدفوعة بالكامل" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SBtnAll" CornerRadius="6" Background="Transparent" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="SBtnAll_Click" Margin="4,0,0,0">
                                        <TextBlock x:Name="STxtAll" Text="كل الفواتير" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SBtnTrash" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="SBtnTrash_Click" Margin="4,0,0,0">
                                        <TextBlock x:Name="STxtTrash" Text="سلة المحذوفات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                            <Border x:Name="SBtnSort" CornerRadius="6" Background="{DynamicResource CardBackgroundAlt}" Padding="10,0" Height="36" Cursor="Hand" MouseLeftButtonDown="SBtnSort_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path FlowDirection="LeftToRight" x:Name="SSortIcon" Width="16" Height="16" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
                                    <TextBlock x:Name="STxtSort" Text="الأحدث" FontSize="11" Foreground="{DynamicResource BodyTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" Height="32">
                            <Grid>
                                <TextBox x:Name="TxtSupplierSearch" FontSize="12" Padding="10,0" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource HeadingTextBrush}"
                                         TextChanged="TxtSupplierSearch_TextChanged" VerticalAlignment="Center" />
                                <TextBlock IsHitTestVisible="False" Text="بحث برقم الفاتورة أو اسم المورد..." FontSize="12"
                                           Foreground="#B0BEC5" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="من" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
                        <DatePicker x:Name="SDpFromDate" Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                    SelectedDateChanged="SupplierDateFilterChanged" />
                        <TextBlock Grid.Column="3" Text="إلى" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
                        <DatePicker x:Name="SDpToDate" Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                    SelectedDateChanged="SupplierDateFilterChanged" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Supplier invoices list -->
            <StackPanel x:Name="SupplierInvoicesPanel" Grid.Row="2" />

            <!-- Show more -->
            <Border x:Name="SupplierShowMoreBar" Grid.Row="3" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}"
                    Padding="12,10" Cursor="Hand" MouseLeftButtonDown="SupplierShowMore_Click"
                    Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M7 10l5 5 5-5z" />
                    <TextBlock x:Name="TxtSupplierShowMore" Text="عرض المزيد" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" Margin="6,0,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Height="8" />
                    </Grid>
            </TabItem>
        </TabControl>
        </Grid>
    </ScrollViewer>
</Page>
