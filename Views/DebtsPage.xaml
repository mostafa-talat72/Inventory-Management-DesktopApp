<Page x:Class="ProductApp.Views.DebtsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="المديونات"
      FlowDirection="RightToLeft"
      Background="{DynamicResource AppBackground}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="14" Background="#FCE4EC">
                <Path FlowDirection="LeftToRight" Width="22" Height="22" Fill="#C62828" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l1-0.54V17h2V9L12 3zM8 17.15v-4.44l4 2.22 4-2.22v4.44L12 19.4l-4-2.25zM6 9.83V7.36l6-3.26 6 3.26v2.47l-6 3.26-6-3.26z" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="المديونات" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="إدارة الديون المسجلة عليك وعلى الآخرين لك" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Summary cards -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="المتبقي عليا" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TxtOnMeRemaining" Text="0 ج.م" FontSize="18" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtOnMeCount" Text="0 دين" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="المتبقي لي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TxtForMeRemaining" Text="0 ج.م" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtForMeCount" Text="0 دين" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16" Cursor="Hand" MouseLeftButtonDown="CustomerDebtCard_Click">
                <StackPanel>
                    <TextBlock Text="دين العملاء لي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TxtCustomerDebt" Text="0 ج.م" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtCustomerDebtDesc" Text="من فواتير العملاء تلقائياً" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="16" Cursor="Hand" MouseLeftButtonDown="SupplierDebtCard_Click">
                <StackPanel>
                    <TextBlock Text="ديوني للموردين" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TxtSupplierDebt" Text="0 ج.م" FontSize="18" FontWeight="Bold" Foreground="#00695C" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtSupplierDebtDesc" Text="من فواتير الموردين تلقائياً" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="المتبقي الكلي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TxtTotalRemaining" Text="0 ج.م" FontSize="18" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0" />
                    <TextBlock Text="الفرق بعد مقاصة عليا ولي والعملاء والموردين" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Border x:Name="BtnAll" CornerRadius="6" Background="#C62828" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnAll_Click">
                <TextBlock x:Name="TxtAll" Text="كل الديون" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnOnMe" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnOnMe_Click" Margin="4,0,0,0">
                <TextBlock x:Name="TxtOnMe" Text="عليا" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="BtnForMe" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnForMe_Click" Margin="4,0,0,0">
                <TextBlock x:Name="TxtForMe" Text="لي" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- دين العملاء لي (تلقائي) -->
                <Border x:Name="CustomerDebtCard" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14"
                        Background="#1565C0" Cursor="Hand" MouseLeftButtonDown="CustomerDebtCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#1E88E5" VerticalAlignment="Center">
                            <Path FlowDirection="LeftToRight" Width="20" Height="20" Fill="White" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="دين العملاء لي" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <Border CornerRadius="3" Background="#33FFFFFF" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="تلقائي" FontSize="9" FontWeight="Bold" Foreground="#90CAF9" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtCustomerDebtDesc2" Text="" FontSize="11" Foreground="#90CAF9" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtCustomerDebtAmount" Grid.Column="2" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ديوني للموردين (تلقائي) -->
                <Border x:Name="SupplierDebtCard" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14"
                        Background="#00695C" Cursor="Hand" MouseLeftButtonDown="SupplierDebtCard_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#00897B" VerticalAlignment="Center">
                            <Path FlowDirection="LeftToRight" Width="20" Height="20" Fill="White" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l1-0.54V17h2V9L12 3zM8 17.15v-4.44l4 2.22 4-2.22v4.44L12 19.4l-4-2.25zM6 9.83V7.36l6-3.26 6 3.26v2.47l-6 3.26-6-3.26z" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ديوني للموردين" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <Border CornerRadius="3" Background="#33FFFFFF" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="تلقائي" FontSize="9" FontWeight="Bold" Foreground="#A5D6A7" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtSupplierDebtDesc2" Text="" FontSize="11" Foreground="#A5D6A7" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSupplierDebtAmount" Grid.Column="2" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- الحسابات الدائمة -->
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الحسابات الدائمة" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" CornerRadius="4" Background="#E8F5E9" Padding="6,1" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtAccountsCount" Text="0 حساب" FontSize="10" FontWeight="Bold" Foreground="#2E7D32" />
                    </Border>
                    <Button Grid.Column="3" Click="BtnAddAccount_Click" Height="34" Cursor="Hand" Padding="16,0"
                            Background="#00695C" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path FlowDirection="LeftToRight" Width="13" Height="13" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                        <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        إضافة حساب دائم
                    </Button>
                </Grid>
                <WrapPanel x:Name="AccountsPanel" Margin="0,0,0,10" />

                <WrapPanel x:Name="DebtsPanel" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>