<UserControl x:Class="ProductApp.Views.SelectDebtAccountDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="520" MaxWidth="680"
             MinHeight="460" MaxHeight="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" Padding="28,24,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource SurfaceBackground}">
                    <Path FlowDirection="LeftToRight" Width="22" Height="22" Fill="#C62828" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="اختيار شخص" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="لا يمكن تسجيل دين إلا لشخص موجود — اختر أو أضف شخصاً جديداً" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Click="BtnClose_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Width="36" Height="36"
                        ToolTip="إغلاق" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="0">
                                <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="#78909C" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Accent divider -->
        <Rectangle Grid.Row="0" Height="3" Fill="#C62828" Margin="28,0,28,0" VerticalAlignment="Bottom" />

        <!-- Search + Add -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" Padding="28,16,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource InputBackground}">
                    <TextBox x:Name="TxtSearch" FontSize="13" BorderThickness="0" Background="Transparent"
                             Padding="10,8" wm:WatermarkBehavior.Watermark="بحث عن شخص..." TextChanged="TxtSearch_TextChanged" />
                </Border>
                <Button Grid.Column="1" Click="BtnAddAccount_Click" Height="38" Cursor="Hand" Padding="16,0" Margin="12,0,0,0"
                        Background="#00695C" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                    <ContentPresenter VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    إضافة شخص
                </Button>
            </Grid>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="2" Background="{DynamicResource CardBackground}" Padding="28,12,28,8" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AccountsPanel" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource OverlayFooterBrush}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource OverlayFooterBorder}" Padding="28,12">
            <TextBlock Text="اضغط على الشخص لاختياره" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
    </Grid>
</UserControl>