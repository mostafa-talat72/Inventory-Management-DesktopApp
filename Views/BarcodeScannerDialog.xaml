<UserControl x:Class="ProductApp.Views.BarcodeScannerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             MinWidth="560" MaxWidth="720">
    <Border CornerRadius="14" Background="{DynamicResource AppBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.3" Color="#1A237E" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1A237E" CornerRadius="14,14,0,0" Padding="22,13,22,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#3949AB">
                        <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M15 2H9c-1.1 0-2 .9-2 2v2h2V4h6v2h2V4c0-1.1-.9-2-2-2zM15 22H9c-1.1 0-2-.9-2-2v-2h2v2h6v-2h2v2c0 1.1-.9 2-2 2zM22 15h-2V9h2v6zM6 15H4V9h2v6zM15 9H9v6h6V9z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="مسح الباركود" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="وجّه الكاميرا نحو الباركود ليتم إدخاله تلقائياً" FontSize="10" Foreground="#9FA8DA" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,20,24,24">
                <!-- Camera preview -->
                <Border CornerRadius="12" Background="#11151F" Height="270" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="CameraPreview" Stretch="Uniform" />
                        <TextBlock x:Name="TxtCameraStatus" Text="جارٍ تشغيل الكاميرا..."
                                   FontSize="13" Foreground="#90A4AE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Scan status -->
                <Border x:Name="StatusBar" CornerRadius="8" Margin="0,12,0,0" Padding="12,10"
                        Background="{DynamicResource CardBackgroundAlt}" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{DynamicResource BodyTextBrush}" />
                </Border>

                <!-- Manual entry -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="2">
                        <TextBox x:Name="TxtManualCode" FontSize="13" Height="38" BorderThickness="0" Padding="10,0"
                                 VerticalContentAlignment="Center" Background="Transparent"
                                 Foreground="{DynamicResource HeadingTextBrush}"
                                 CaretBrush="{DynamicResource HeadingTextBrush}"
                                 KeyDown="TxtManualCode_KeyDown"
                                 ToolTip="أدخل الباركود يدوياً إذا لم تتوفر كاميرا" />
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnAccept" Click="BtnAccept_Click"
                            Height="38" Margin="8,0,0,0" Padding="18,0" Cursor="Hand"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                                        <TextBlock Text="  قبول" Margin="3,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnClose" Click="BtnClose_Click"
                            Height="38" Margin="8,0,0,0" Padding="18,0" Cursor="Hand"
                            Background="#546E7A" Foreground="White" BorderThickness="0"
                            FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                        <TextBlock Text="  إغلاق" Margin="3,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>