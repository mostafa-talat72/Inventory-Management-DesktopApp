<UserControl x:Class="ProductApp.Views.DebtPaymentsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             MinWidth="440" MaxWidth="520" MinHeight="400" MaxHeight="640">
    <Border CornerRadius="14" Background="{DynamicResource CardBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#00695C" CornerRadius="14,14,0,0" Padding="22,16,10,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#00897B" VerticalAlignment="Center">
                        <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="دفعات الدين" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="TxtSubtitle" Text="" FontSize="11" Foreground="#A5D6A7" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="BtnClose_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Width="32" Height="32" VerticalAlignment="Center"
                            ToolTip="إغلاق">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#33FFFFFF" CornerRadius="8" Padding="0">
                                    <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Summary -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="الإجمالي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtTotal" Text="0 ج.م" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="المدفوع" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtPaid" Text="0 ج.م" FontSize="15" FontWeight="Bold" Foreground="#1565C0" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="المتبقي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtRemaining" Text="0 ج.م" FontSize="15" FontWeight="Bold" Foreground="#E65100" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Payments list -->
            <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PaymentsPanel" Margin="16,0,16,10" />
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" CornerRadius="0,0,14,14" Background="{DynamicResource OverlayFooterBrush}" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource OverlayFooterBorder}" Padding="22,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnAddPayment" Click="BtnAddPayment_Click" Height="36" Cursor="Hand" Padding="18,0"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                        <ContentPresenter VerticalAlignment="Center" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        إضافة دفعة
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>