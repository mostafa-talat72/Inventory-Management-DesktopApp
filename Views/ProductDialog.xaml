<UserControl x:Class="ProductApp.Views.ProductDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="900" MaxWidth="1280" MinHeight="500" MaxHeight="760">
    <Border CornerRadius="14" Background="{DynamicResource AppBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.25" Color="#1A237E" />
        </Border.Effect>
        <Grid Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, FallbackValue=720}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1A237E" CornerRadius="14,14,0,0" Padding="22,13,22,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#3949AB">
                        <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.2V15.91M13,19.29L19,15.91V9.2L13,12.58V19.29Z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtHeader" Text="إضافة منتج جديد"
                                   FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="أدخل بيانات المنتج ومستويات التعبئة"
                                   FontSize="10" Foreground="#9FA8DA" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="BtnCancel_Click"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Width="32" Height="32" ToolTip="إغلاق">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                                    <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#3949AB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- COL 1: النموذج -->
                <Grid Grid.Column="1">

                    <!-- نموذج المنتج -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  wm:ScrollBehavior.ForceMouseWheel="True">
                        <StackPanel Margin="24,20,24,20">

                            <!-- اسم + وصف -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBox x:Name="TxtName" wm:WatermarkBehavior.Watermark="اسم المنتج *"
                                             Style="{StaticResource FormField}" FontSize="14" Height="42"
                                             Foreground="{DynamicResource HeadingTextBrush}"
                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                    <TextBox x:Name="TxtDescription" wm:WatermarkBehavior.Watermark="وصف المنتج (اختياري)"
                                             Style="{StaticResource FormField}" Margin="0,8,0,0" FontSize="14" Height="42"
                                             Foreground="{DynamicResource HeadingTextBrush}"
                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                    <TextBox x:Name="TxtBarcode" wm:WatermarkBehavior.Watermark="الباركود (اختياري)"
                                             Style="{StaticResource FormField}" Margin="0,8,0,0" FontSize="14" Height="42"
                                             Foreground="{DynamicResource HeadingTextBrush}"
                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Width="56" Height="56" CornerRadius="10" Background="#ECEFF1"
                                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="ImgPreview" Width="56" Height="56" Stretch="UniformToFill"
                                                       Visibility="Collapsed" />
                                                <Path x:Name="ImgPlaceholder" FlowDirection="LeftToRight" Width="24" Height="24"
                                                      Fill="#90A4AE" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17M12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15Z" />
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button x:Name="BtnChooseImage" Click="BtnChooseImage_Click"
                                                    Height="34" Padding="14,0" Cursor="Hand"
                                                    Background="#3949AB" Foreground="White" BorderThickness="0"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    HorizontalAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" CornerRadius="8"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                اختيار صورة
                                            </Button>
                                            <Button x:Name="BtnRemoveImage" Click="BtnRemoveImage_Click"
                                                    Height="30" Padding="12,0" Cursor="Hand" Margin="0,6,0,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    FontSize="11" Foreground="#C62828"
                                                    HorizontalAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" CornerRadius="8"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="#FFEBEE" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                إزالة الصورة
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- القطعة -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1A237E">
                                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="TxtPieceTitle" Text="القطعة" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeadingTextBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border CornerRadius="4" Background="#E8EAF6" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="اختياري" FontSize="10" FontWeight="SemiBold" Foreground="#3F51B5" />
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkHasPiece" Content="يوجد قطعة"
                                              FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}"
                                              FontSize="13" Margin="0,0,0,12"
                                              Checked="ChkHasPiece_Checked" Unchecked="ChkHasPiece_Unchecked" />
                                    <Border x:Name="PiecePanel" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                            Background="{DynamicResource SurfaceBackground}" IsEnabled="False" Opacity="0.5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackgroundAlt}">
                                                    <TextBox x:Name="TxtPieceName" Text="قطعة" FontSize="13"
                                                             Padding="10,8" BorderThickness="0" Background="Transparent"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}"
                                                             TextChanged="UnitName_TextChanged"
                                                             HorizontalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackgroundAlt}">
                                                <TextBox x:Name="TxtPieceRetail" wm:WatermarkBehavior.Watermark="سعر القطاعي *"
                                                         FontSize="13" Padding="10,8" BorderThickness="0"
                                                         Background="Transparent" TextChanged="Price_TextChanged"
                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                         CaretBrush="{DynamicResource HeadingTextBrush}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackgroundAlt}">
                                                <TextBox x:Name="TxtPieceWholesale" wm:WatermarkBehavior.Watermark="سعر الجملة"
                                                         FontSize="13" Padding="10,8" BorderThickness="0"
                                                         Background="Transparent" TextChanged="Price_TextChanged"
                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                         CaretBrush="{DynamicResource HeadingTextBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- العلبة -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#00897B">
                                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="TxtBoxTitle" Text="العلبة" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeadingTextBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border CornerRadius="4" Background="#E0F2F1" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="اختياري" FontSize="10" FontWeight="SemiBold" Foreground="#00897B" />
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkHasBox" Content="يوجد علبة"
                                              FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}"
                                              FontSize="13" Margin="0,0,0,12"
                                              Checked="ChkHasBox_Checked" Unchecked="ChkHasBox_Unchecked" />
                                    <Border x:Name="BoxPanel" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                            Background="{DynamicResource SurfaceBackground}" IsEnabled="False" Opacity="0.5">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtBoxUnitLabel" Text="العلبة تحتوي على: قطع"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="BoxQtyCol" Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackground}">
                                                    <TextBox x:Name="TxtBoxName" Text="علبة" FontSize="12"
                                                             Padding="8,6" BorderThickness="0" Background="Transparent"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}"
                                                             TextChanged="UnitName_TextChanged"
                                                             HorizontalAlignment="Center" />
                                                </Border>
                                                <Border Grid.Column="1" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackground}">
                                                    <TextBox x:Name="TxtBoxQty" wm:WatermarkBehavior.Watermark="عدد القطع *"
                                                             FontSize="12" Padding="8,6" BorderThickness="0"
                                                             Background="Transparent" TextChanged="Qty_TextChanged"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                                </Border>
                                                <Border Grid.Column="2" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource InputBackground}">
                                                    <TextBox x:Name="TxtBoxRetail" wm:WatermarkBehavior.Watermark="سعر القطاعي"
                                                             FontSize="12" Padding="8,6" BorderThickness="0"
                                                             Background="Transparent" TextChanged="Price_TextChanged"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                                </Border>
                                                <Border Grid.Column="3" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource InputBackground}">
                                                    <TextBox x:Name="TxtBoxWholesale" wm:WatermarkBehavior.Watermark="سعر الجملة"
                                                             FontSize="12" Padding="8,6" BorderThickness="0"
                                                             Background="Transparent" TextChanged="Price_TextChanged"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtBoxHint" FontSize="10"
                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- الكرتونة -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#00897B">
                                            <TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="TxtCartonTitle" Text="الكرتونة" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeadingTextBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border CornerRadius="4" Background="#E0F2F1" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="اختياري" FontSize="10" FontWeight="SemiBold" Foreground="#00897B" />
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkHasCarton" Content="يوجد كرتونة"
                                              FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}"
                                              FontSize="13" Margin="0,0,0,12"
                                              Checked="ChkHasCarton_Checked" Unchecked="ChkHasCarton_Unchecked" />
                                    <Border x:Name="CartonPanel" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                            Background="{DynamicResource SurfaceBackground}" IsEnabled="False" Opacity="0.5">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtCartonUnitLabel" Text="الكرتونة تحتوي على:"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="CartonQtyCol" Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackground}">
                                                    <TextBox x:Name="TxtCartonName" Text="كرتونة" FontSize="12"
                                                             Padding="8,6" BorderThickness="0" Background="Transparent"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}"
                                                             TextChanged="UnitName_TextChanged"
                                                             HorizontalAlignment="Center" />
                                                </Border>
                                                <Border Grid.Column="1" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource CardBackground}">
                                                    <TextBox x:Name="TxtCartonQty" wm:WatermarkBehavior.Watermark="العدد *"
                                                             FontSize="12" Padding="8,6" BorderThickness="0"
                                                             Background="Transparent" TextChanged="Qty_TextChanged"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                                </Border>
                                                <Border Grid.Column="2" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource InputBackground}">
                                                    <TextBox x:Name="TxtCartonRetail" wm:WatermarkBehavior.Watermark="سعر القطاعي"
                                                             FontSize="12" Padding="8,6" BorderThickness="0"
                                                             Background="Transparent" TextChanged="Price_TextChanged"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                                </Border>
                                                <Border Grid.Column="3" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="2" Background="{DynamicResource InputBackground}">
                                                    <TextBox x:Name="TxtCartonWholesale" wm:WatermarkBehavior.Watermark="سعر الجملة"
                                                             FontSize="12" Padding="8,6" BorderThickness="0"
                                                             Background="Transparent" TextChanged="Price_TextChanged"
                                                             Foreground="{DynamicResource HeadingTextBrush}"
                                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtCartonHint" FontSize="10"
                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- الحد الأدنى للمخزون -->
                            <Border CornerRadius="12" Background="{DynamicResource CardBackground}"
                                    Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#E65100">
                                            <TextBlock Text="5" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="الحد الأدنى للمخزون" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeadingTextBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="تنبيه على الكارت عند نزول المخزون عن الحد"
                                                   FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="PieceMinField" Orientation="Horizontal" Margin="0,0,20,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPieceMinLabel" Text="(قطعة):"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}"
                                                    BorderThickness="1" Background="{DynamicResource InputBackground}">
                                                <TextBox x:Name="TxtPieceMin" Width="80" Height="32" FontSize="12"
                                                         Padding="6,0" BorderThickness="0" Background="Transparent"
                                                         wm:WatermarkBehavior.Watermark="0"
                                                         HorizontalContentAlignment="Center"
                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                         CaretBrush="{DynamicResource HeadingTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="BoxMinField" Orientation="Horizontal" Margin="0,0,20,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBoxMinLabel" Text="(علبة):"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}"
                                                    BorderThickness="1" Background="{DynamicResource InputBackground}">
                                                <TextBox x:Name="TxtBoxMin" Width="80" Height="32" FontSize="12"
                                                         Padding="6,0" BorderThickness="0" Background="Transparent"
                                                         wm:WatermarkBehavior.Watermark="0"
                                                         HorizontalContentAlignment="Center"
                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                         CaretBrush="{DynamicResource HeadingTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="CartonMinField" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCartonMinLabel" Text="(كرتونة):"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}"
                                                    BorderThickness="1" Background="{DynamicResource InputBackground}">
                                                <TextBox x:Name="TxtCartonMin" Width="80" Height="32" FontSize="12"
                                                         Padding="6,0" BorderThickness="0" Background="Transparent"
                                                         wm:WatermarkBehavior.Watermark="0"
                                                         HorizontalContentAlignment="Center"
                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                         CaretBrush="{DynamicResource HeadingTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- أزرار -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSave" Click="BtnSave_Click"
                                        Height="42" Padding="24,0" Cursor="Hand"
                                        Background="#1A237E" Foreground="White" BorderThickness="0"
                                        FontSize="13" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                                          Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17Z" />
                                                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    حفظ
                                </Button>
                                <Button x:Name="BtnSaveAndAdd" Click="BtnSaveAndAdd_Click"
                                        Height="42" Padding="20,0" Cursor="Hand" Margin="10,0,0,0"
                                        Background="#00897B" Foreground="White" BorderThickness="0"
                                        FontSize="13" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                                          Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                                                    <TextBlock Text="حفظ وإضافة آخر" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Click="BtnCancel_Click"
                                        Height="42" Padding="20,0" Cursor="Hand" Margin="10,0,0,0"
                                        Background="{DynamicResource CardBackgroundAlt}"
                                        Foreground="{DynamicResource BodyTextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        FontSize="13" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceBackground}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    إلغاء
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
