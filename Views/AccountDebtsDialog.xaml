<UserControl x:Class="ProductApp.Views.AccountDebtsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             MinWidth="520" MaxWidth="700" MinHeight="420" MaxHeight="640">
    <Border CornerRadius="14" Background="{DynamicResource CardBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#00695C" CornerRadius="14,14,0,0" Padding="22,16,10,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#00897B" VerticalAlignment="Center">
                        <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="ديون الحساب" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="TxtSubtitle" Text="" FontSize="11" Foreground="#A5D6A7" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="BtnClose_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Width="32" Height="32" VerticalAlignment="Center"
                            ToolTip="إغلاق">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#33FFFFFF" CornerRadius="8" Padding="0">
                                    <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Summary -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="عدد الديون" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtDebtCount" Text="0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="عليا" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtOnMe" Text="0 ج.م" FontSize="15" FontWeight="Bold" Foreground="#C62828" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="لي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtForMe" Text="0 ج.م" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="المتبقي الكلي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtRemaining" Text="0 ج.م" FontSize="15" FontWeight="Bold" Foreground="#E65100" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

<!-- Filter bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="قائمة الديون" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}" Padding="4,0" Height="32"
                        HorizontalAlignment="Left" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BtnAll" CornerRadius="6" Background="#00695C" Padding="14,0" Height="24" Cursor="Hand" MouseLeftButtonDown="BtnAll_Click">
                            <TextBlock x:Name="TxtAll" Text="كل الديون" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="BtnOpen" CornerRadius="6" Background="Transparent" Padding="12,0" Height="24" Cursor="Hand" MouseLeftButtonDown="BtnOpen_Click" Margin="4,0,0,0">
                            <TextBlock x:Name="TxtOpen" Text="مفتوح" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="BtnPartial" CornerRadius="6" Background="Transparent" Padding="12,0" Height="24" Cursor="Hand" MouseLeftButtonDown="BtnPartial_Click" Margin="4,0,0,0">
                            <TextBlock x:Name="TxtPartial" Text="مسدد جزئياً" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="BtnPaid" CornerRadius="6" Background="Transparent" Padding="12,0" Height="24" Cursor="Hand" MouseLeftButtonDown="BtnPaid_Click" Margin="4,0,0,0">
                            <TextBlock x:Name="TxtPaid" Text="مسدد" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" x:Name="BtnSort" CornerRadius="6" Background="{DynamicResource CardBackgroundAlt}" Padding="10,0" Height="32"
                        Cursor="Hand" MouseLeftButtonDown="BtnSort_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
                        <TextBlock x:Name="TxtSort" Text="الأحدث" FontSize="11" Foreground="{DynamicResource BodyTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Debts list -->
        <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DebtsPanel" Margin="16,0,16,12" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="4" CornerRadius="0,0,14,14" Background="{DynamicResource OverlayFooterBrush}" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource OverlayFooterBorder}" Padding="22,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Click="BtnAddDebt_Click" Height="36" Cursor="Hand" Padding="18,0"
                            Background="#C62828" Foreground="White" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                              Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                        <ContentPresenter VerticalAlignment="Center" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        إضافة دين
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>