<UserControl x:Class="ProductApp.Views.DebtDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="420" MaxWidth="520">
    <Border CornerRadius="14" Background="{DynamicResource CardBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#C62828" CornerRadius="14,14,0,0" Padding="22,16,10,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#E53935" VerticalAlignment="Center">
                        <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l1-0.54V17h2V9L12 3zM8 17.15v-4.44l4 2.22 4-2.22v4.44L12 19.4l-4-2.25zM6 9.83V7.36l6-3.26 6 3.26v2.47l-6 3.26-6-3.26z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtHeader" Text="إضافة دين" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="TxtSubHeader" Text="سجّل ديناً عليك أو لك" FontSize="11" Foreground="#FFCDD2" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="BtnClose_Click"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Width="32" Height="32" VerticalAlignment="Center"
                            ToolTip="إغلاق">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#33FFFFFF" CornerRadius="8" Padding="0">
                                    <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,20,24,0">
                <Border CornerRadius="8" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <TextBlock Text="الشخص" FontSize="11" Foreground="#2E7D32" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="#2E7D32" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                            <TextBlock x:Name="TxtAccountName" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="نوع الدين" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingTextBrush}" Margin="0,16,0,0" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DirOnMe" Grid.Column="0" CornerRadius="8" Cursor="Hand"
                            Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" Padding="12,8"
                            MouseLeftButtonDown="DirOnMe_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="#C62828" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Data="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z" />
                            <TextBlock Text="عليا (أنا مديون)" FontSize="12" FontWeight="Bold" Foreground="#C62828" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DirForMe" Grid.Column="2" CornerRadius="8" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8"
                            MouseLeftButtonDown="DirForMe_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="#90A4AE" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Data="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z" />
                            <TextBlock x:Name="TxtForMeLabel" Text="لي (شخص مديون لي)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="إجمالي المبلغ (المتبقي المستحق)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingTextBrush}" Margin="0,16,0,0" />
                <Border Margin="0,6,0,0" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource InputBackground}">
                    <TextBox x:Name="TxtAmount" Text="0" FontSize="14" BorderThickness="0" Background="Transparent"
                             Padding="10,8" PreviewTextInput="Amount_PreviewTextInput" />
                </Border>

                <TextBlock Text="ملاحظات" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingTextBrush}" Margin="0,16,0,0" />
                <Border Margin="0,6,0,0" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource InputBackground}">
                    <TextBox x:Name="TxtNotes" FontSize="13" BorderThickness="0" Background="Transparent"
                             Padding="10,8" AcceptsReturn="True" Height="64" TextWrapping="Wrap"
                             wm:WatermarkBehavior.Watermark="ملاحظات اختيارية..." />
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,20,24,22">
                <Button Click="BtnSave_Click" Height="38" Cursor="Hand" Padding="24,0"
                        Background="#C62828" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    حفظ
                </Button>
                <Button Click="BtnCancel_Click" Height="38" Cursor="Hand" Padding="24,0" Margin="10,0,0,0"
                        Background="#78909C" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    إلغاء
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>