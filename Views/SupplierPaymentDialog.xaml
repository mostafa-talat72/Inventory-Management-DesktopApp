<UserControl x:Class="ProductApp.Views.SupplierPaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="420" MaxWidth="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" Padding="24,22,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#E8F5E9">
                    <Path FlowDirection="LeftToRight" Width="22" Height="22" Fill="#2E7D32" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="دفع فاتورة مورد" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="TxtInvoiceInfo" Text="" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Click="BtnCancel_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Width="36" Height="36"
                        ToolTip="إغلاق" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="0">
                                <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="#78909C" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Rectangle Grid.Row="0" Height="3" Fill="#2E7D32" Margin="24,0,24,0" VerticalAlignment="Bottom" />

        <!-- Form -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24" Margin="24,20,24,12">
            <StackPanel>
                <Border CornerRadius="10" Background="#E8F5E9" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="المتبقي: " FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtRemaining" Text="0 ج.م" FontSize="22" FontWeight="ExtraBold" Foreground="#1B5E20" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="المبلغ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,0,0,6" />
                    <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource CardBackgroundAlt}">
                        <TextBox x:Name="TxtAmount" FontSize="16" FontWeight="Bold"
                                 Padding="12,10" BorderThickness="0"
                                 TextAlignment="Center"
                                 Background="Transparent" Foreground="#1A237E" CaretBrush="#1A237E"
                                 PreviewTextInput="TxtAmount_PreviewTextInput"
                                 DataObject.Pasting="TxtAmount_Pasting"
                                 TextChanged="TxtAmount_TextChanged" />
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="طريقة الدفع" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="CmbMethod" SelectedIndex="0" Height="40" FontSize="13">
                        <ComboBoxItem Content="نقدي" />
                        <ComboBoxItem Content="كارت" />
                        <ComboBoxItem Content="تحويل بنكي" />
                        <ComboBoxItem Content="شيك" />
                        <ComboBoxItem Content="محفظة إلكترونية" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="ملاحظات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,0,0,6" />
                    <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource CardBackgroundAlt}">
                        <TextBox x:Name="TxtNotes"
                                 wm:WatermarkBehavior.Watermark="ملاحظات (اختياري)"
                                 Padding="12,10" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource HeadingTextBrush}" CaretBrush="{DynamicResource HeadingTextBrush}" FontSize="13" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,4,24,24">
            <Button Click="BtnSave_Click"
                    Height="40" Cursor="Hand" Padding="24,0"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17Z" />
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                تأكيد الدفع
            </Button>
            <Button Click="BtnCancel_Click"
                    Height="40" Cursor="Hand" Padding="24,0" Margin="12,0,0,0"
                    Background="#78909C" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                إلغاء
            </Button>
        </StackPanel>
    </Grid>
</UserControl>