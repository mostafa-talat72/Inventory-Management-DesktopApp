<UserControl x:Class="ProductApp.Views.DebtPaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="380" MaxWidth="500">
    <Border CornerRadius="14" Background="{DynamicResource CardBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Border CornerRadius="14,14,0,0" Background="{StaticResource PrimaryBrush}" Padding="24,20">
                <StackPanel>
                    <TextBlock x:Name="TxtHeader" Text="دفعة جديدة" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="TxtDebtInfo" Text="" FontSize="13" Foreground="#B0BEC5" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Margin="24,20,24,24">
                <TextBlock Text="المبلغ" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BodyTextBrush}" Margin="0,0,0,4" />
                <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0">
                    <Grid>
                        <TextBox x:Name="TxtAmount" FontSize="18" FontWeight="SemiBold" Padding="12,10"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 wm:WatermarkBehavior.Watermark="أدخل المبلغ"
                                 PreviewTextInput="Amount_PreviewTextInput" />
                        <TextBlock Text="ج.م" FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TxtAmount, Path=Text.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border CornerRadius="8" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                        Padding="12,10" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock Text="المتبقي" FontSize="12" Foreground="#F57F17" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtRemaining" FontSize="15" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <TextBlock Text="طريقة الدفع" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BodyTextBrush}" Margin="0,16,0,4" />
                <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                    <ComboBox x:Name="CmbMethod" FontSize="14" Padding="8,6" BorderThickness="0" Background="Transparent">
                        <ComboBoxItem Content="نقدي" IsSelected="True" />
                        <ComboBoxItem Content="تحويل بنكي" />
                        <ComboBoxItem Content="محفظة الكترونية" />
                    </ComboBox>
                </Border>

                <TextBlock Text="ملاحظات" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BodyTextBrush}" Margin="0,16,0,4" />
                <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox x:Name="TxtNotes" FontSize="13" BorderThickness="0" Background="Transparent"
                             Padding="10,8" wm:WatermarkBehavior.Watermark="ملاحظات اختيارية..." />
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,0,24,22">
                <Button Click="BtnSave_Click" Height="38" Cursor="Hand" Padding="24,0"
                        Background="#2E7D32" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    حفظ الدفعة
                </Button>
                <Button Click="BtnCancel_Click" Height="38" Cursor="Hand" Padding="24,0" Margin="10,0,0,0"
                        Background="#78909C" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    إلغاء
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>