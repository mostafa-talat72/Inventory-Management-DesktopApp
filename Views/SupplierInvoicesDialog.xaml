<UserControl x:Class="ProductApp.Views.SupplierInvoicesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             MinWidth="780" MaxWidth="1250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" Padding="28,24,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#E0F2F1">
                    <Path FlowDirection="LeftToRight" Width="22" Height="22" Fill="#00695C" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M12,3C12.55,3 13,3.45 13,4C13,4.55 12.55,5 12,5C11.45,5 11,4.55 11,4C11,3.45 11.45,3 12,3M17,13H7V11H17V13M17,17H7V15H17V17M17,9H7V7H17V9Z" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TxtTitle" Text="فواتير المورد" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="TxtSubtitle" Text="" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Click="BtnClose_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Width="36" Height="36"
                        ToolTip="إغلاق" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="0">
                                <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="#78909C" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Rectangle Grid.Row="0" Height="3" Fill="#00695C" Margin="28,0,28,0" VerticalAlignment="Bottom" />

        <!-- Summary cards: 5 columns -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="28,16,28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="عدد الفواتير" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtInvoiceCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="إجمالي التوريدات" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtTotalAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="المدفوع" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtPaidAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="عدد المنتجات" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtItemsCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" CornerRadius="10" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="المتبقي" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="TxtRemainingAmount" Text="0 ج.م" FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filter bar + search + sort -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="28,0,28,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="قائمة الفواتير" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}" Padding="4,0" Height="36" HorizontalAlignment="Left">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BtnUnpaid" CornerRadius="6" Background="#1565C0" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnUnpaid_Click">
                                    <TextBlock x:Name="TxtUnpaid" Text="غير مدفوعة" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnPartiallyPaid" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnPartiallyPaid_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtPartiallyPaid" Text="مدفوعة جزئياً" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnCancelled" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnCancelled_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtCancelled" Text="ملغاة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnPaid" CornerRadius="6" Background="Transparent" Padding="14,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnPaid_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtPaid" Text="مدفوعة بالكامل" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="BtnAll" CornerRadius="6" Background="Transparent" Padding="16,0" Height="28" Cursor="Hand" MouseLeftButtonDown="BtnAll_Click" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtAll" Text="كل الفواتير" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <!-- Sort button -->
                        <Border x:Name="BtnSort" CornerRadius="6" Background="{DynamicResource CardBackgroundAlt}" Padding="10,0" Height="36" Cursor="Hand" MouseLeftButtonDown="BtnSort_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path FlowDirection="LeftToRight" x:Name="SortIcon" Width="16" Height="16" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
                                <TextBlock x:Name="TxtSort" Text="الأحدث" FontSize="11" Foreground="{DynamicResource BodyTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- Search row -->
                <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" Height="32">
                    <Grid>
                        <TextBox x:Name="TxtSearch" FontSize="12" Padding="10,0" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource HeadingTextBrush}"
                                 TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center" />
                        <TextBlock IsHitTestVisible="False" Text="بحث برقم الفاتورة أو اسم المورد..." FontSize="12"
                                   Foreground="#B0BEC5" VerticalAlignment="Center" Margin="12,0,0,0"
                                   x:Name="SearchWatermark" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Batch action bar (visible when items selected) -->
        <Border x:Name="BatchBar" Grid.Row="3" Margin="28,0,28,8" CornerRadius="8" Background="#F3E5F5"
                Padding="12,8" Visibility="Collapsed" BorderBrush="#CE93D8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="6" Background="#E1BEE7" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBatchCount" Text="0" FontSize="12" FontWeight="Bold" Foreground="#6A1B9A" />
                </Border>
                <TextBlock Grid.Column="1" Text="محددة" FontSize="11" Foreground="#7B1FA2" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Border Grid.Column="2" CornerRadius="6" Background="#546E7A" Padding="10,6" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="BatchPrint_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path FlowDirection="LeftToRight" Width="14" Height="14" Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" />
                        <TextBlock Text="طباعة المحدد" FontSize="11" FontWeight="Bold" Foreground="White" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" CornerRadius="6" Background="#C62828" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="BatchClear_Click">
                    <TextBlock Text="إلغاء التحديد" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <!-- Invoice cards list -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="28,0,28,0">
            <StackPanel x:Name="InvoicesPanel" />
        </ScrollViewer>

        <!-- Show more / Load all -->
        <Border x:Name="ShowMoreBar" Grid.Row="5" Margin="28,8,28,0" CornerRadius="8" Background="{DynamicResource CardBackgroundAlt}"
                Padding="12,10" Cursor="Hand" MouseLeftButtonDown="ShowMore_Click"
                Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="#546E7A" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M7 10l5 5 5-5z" />
                <TextBlock x:Name="TxtShowMore" Text="عرض المزيد" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BodyTextBrush}" Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left" Margin="28,12,28,24">
            <Button x:Name="BtnAddOrder" Click="BtnAddOrder_Click"
                    Height="40" Cursor="Hand" Padding="24,0"
                    Background="#00695C" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                إضافة طلبية
            </Button>
            <Button x:Name="BtnPrintAll" Click="BtnPrintAll_Click"
                    Height="40" Cursor="Hand" Padding="24,0"
                    Background="#546E7A" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" />
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                طباعة الكل
            </Button>
            <Button x:Name="BtnPaySupplier" Click="BtnPaySupplier_Click"
                    Height="40" Cursor="Hand" Padding="24,0"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" />
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                دفع الفواتير
            </Button>
            <Button Click="BtnClose_Click"
                    Height="40" Cursor="Hand" Padding="24,0"
                    Background="#78909C" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                إغلاق
            </Button>
        </StackPanel>
    </Grid>
</UserControl>